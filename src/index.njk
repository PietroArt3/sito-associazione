---
layout: base.njk
title: "Ultime Notizie"
description: "AMO - Associazione Malati Oncologici ODV di Carpi: notizie, eventi e iniziative in primo piano a sostegno dei pazienti oncologici."
---

<style>
@media (max-width: 768px) {
.titolo-principale {
font-size: 2rem !important;
}
.sottotitolo-blue {
font-size: 1.6rem !important;
}
.container-flex-notizie {
flex-direction: column-reverse;
}
.fb-container, .primo-piano-container, .sidebar-left-container {
max-width: 100% !important;
min-width: 100% !important;
}
.sidebar-left-container {
display: flex;
flex-direction: column;
gap: 20px;
}
}
/* Ultime notizie: il testo lungo si ferma a 4 righe, con "Leggi tutto" per aprirlo */
.notizia-testo {
display: -webkit-box;
-webkit-box-orient: vertical;
-webkit-line-clamp: 4;
overflow: hidden;
}
.notizia-testo.aperta {
display: block;
}
.notizia-altro {
margin-top: 6px;
padding: 0;
border: none;
background: none;
color: #0066cc;
font-family: inherit;
font-size: 0.9rem;
font-weight: bold;
cursor: pointer;
}
</style>

<section style="margin: 0 auto 40px auto; max-width: 1300px; padding: 0 20px; font-family: sans-serif;">

<div style="display: flex; justify-content: center; width: 100%; padding: 0; margin: 30px 0 20px 0;">
    <div style="position: relative;
                width: 97%;
                max-width: 1600px;
                margin: 0 auto;
                padding: 40px 15px;
                text-align: center;
                overflow: hidden;
                border-radius: 30px;
                box-shadow: 0 15px 40px rgba(0,0,0,0.1);
                box-sizing: border-box;">

        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                    background-image: url('/img/immagine_nastri.jpg');
                    background-size: cover; background-position: center;
                    filter: blur(2px); transform: scale(1.1); z-index: 1;">
        </div>

        <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%;
                    background: rgba(255, 255, 255, 0.1); z-index: 2;">
        </div>

        <div style="position: relative; z-index: 3; display: inline-block;
                    background: rgba(255, 255, 255, 0.70);
                    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
                    padding: 30px 20px; border-radius: 20px;
                    border: 1px solid rgba(255, 255, 255, 0.5);
                    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
                    width: 100%;
                    max-width: 550px;
                    box-sizing: border-box;">

            <h2 class="titolo-principale" style="font-size: clamp(1.4rem, 6vw, 2.8rem); color: #004a99; line-height: 1.2; margin: 0; font-weight: 800; text-transform: uppercase; letter-spacing: -0.5px;">
                Associazione <br>
                Malati Oncologici <br>
                <span class="sottotitolo-blue" style="color: #0066cc; font-size: clamp(1.2rem, 5vw, 2.1rem);">ODV CARPI</span>
            </h2>
        </div>

        <div style="position: relative; z-index: 3; margin: 25px auto 0 auto;
                    width: 100%; max-width: 400px;
                    background: #004a99; border-radius: 50px; padding: 10px 15px;
                    display: flex; flex-wrap: wrap; align-items: center; justify-content: center;
                    box-shadow: 0 10px 20px rgba(0,0,0,0.2);
                    box-sizing: border-box;">
            <p style="margin: 0; color: #e1f0ff; font-size: 0.9rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                Devolvi ad AMO il 5x1000:
                <span style="color: #ffffff !important; font-family: monospace; font-size: 1.5rem; margin-left: 5px; background: rgba(255,255,255,0.15); padding: 2px 6px; border-radius: 6px; border: 1px dashed rgba(255,255,255,0.4); display: inline-block;">
                    90014<span style="display:none;">-</span>880364
                </span>
            </p>
        </div>
    </div>
</div>

<div class="container-flex-notizie" style="display: flex; flex-wrap: wrap; gap: 40px; justify-content: center; align-items: flex-start;">

    <div class="sidebar-left-container" style="flex: 1; min-width: 300px; max-width: 450px; display: flex; flex-direction: column; gap: 30px;">

        {% if notizie %}
        {% set mesi = ["gennaio", "febbraio", "marzo", "aprile", "maggio", "giugno", "luglio", "agosto", "settembre", "ottobre", "novembre", "dicembre"] %}
        <div class="notizie-container" style="width: 100%; background: #fff; border: 2px solid #004a99; border-radius: 15px; padding: 20px 20px 5px 20px; box-sizing: border-box; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
            <h4 style="margin: 0 0 5px 0; color: #004a99; text-transform: uppercase; font-weight: 800; font-size: 1.1rem; letter-spacing: 1px; text-align: center;">
                Ultime Notizie
            </h4>
            {# I file delle notizie si chiamano anno-mese-giorno-ora: dal più recente, solo i primi 3 #}
            {% asyncEach chiave, notizia in notizie | dictsort | reverse %}
            {% if loop.index <= 3 %}
            {% set data = chiave.split("-") %}
            <div style="display: flex; gap: 15px; align-items: flex-start; padding: 15px 0;{% if loop.index > 1 %} border-top: 1px solid #eee;{% endif %}">
                {% if notizia.file and notizia.file.toLowerCase().endsWith(".pdf") %}
                <a href="{{ notizia.file }}" target="_blank" aria-label="Apri il PDF"
                   style="flex-shrink: 0; width: 90px; height: 90px; border-radius: 10px; background-color: #416fc8; color: white; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; text-decoration: none; font-weight: bold; box-shadow: 0 4px 10px rgba(0,0,0,0.15);">
                    <i class="fa-solid fa-file-pdf" style="font-size: 1.8rem;"></i> PDF
                </a>
                {% elif notizia.file %}
                <a href="{{ notizia.file }}" target="_blank" style="flex-shrink: 0;">
                    <img src="{{ notizia.file | fotoRidotta(300) }}" alt="Foto della notizia" width="90" height="90" loading="lazy"
                         style="display: block; width: 90px; height: 90px; object-fit: cover; border-radius: 10px; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                </a>
                {% endif %}
                <div style="flex: 1; min-width: 0;">
                    <p style="margin: 0 0 5px 0; color: #0066cc; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                        {{ data[2] | int }} {{ mesi[(data[1] | int) - 1] }} {{ data[0] }}
                    </p>
                    <p class="notizia-testo" style="margin: 0; color: #444; font-size: 0.95rem; line-height: 1.5; white-space: pre-line;">{{ notizia.testo }}</p>
                    <button type="button" class="notizia-altro" hidden>Leggi tutto</button>
                </div>
            </div>
            {% endif %}
            {% endeach %}
        </div>
        {% endif %}

        <div class="fb-container" style="flex: 1; min-width: 300px; max-width: 450px; border: 2px solid #004a99; box-shadow: 0 8px 20px rgba(0,0,0,0.1); border-radius: 15px; overflow: hidden; background: #fff;">
            <div style="display: flex; align-items: center; gap: 15px; padding: 20px;">
                <img src="/img/favicon.png" alt="Logo AMO" width="60" height="60" style="flex-shrink: 0; border-radius: 8px; border: 1px solid #eee;">
                <div>
                    <strong style="display: block; color: #004a99; font-size: 1.1rem; line-height: 1.3;">Associazione Malati Oncologici ODV Carpi</strong>
                    <span style="color: #555; font-size: 0.9rem;">Pagina Facebook ufficiale</span>
                </div>
            </div>
            <div style="padding: 15px 20px; background: #f9f9f9; border-top: 1px solid #eee; text-align: center;">
                <a href="https://www.facebook.com/amo.carpi" target="_blank" rel="noopener"
                   style="display: inline-flex; align-items: center; gap: 10px; background: #004a99; color: white; padding: 10px 20px; border-radius: 8px; font-size: 1rem; font-weight: bold; text-decoration: none;">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                    Segui la Pagina
                </a>
            </div>
        </div>

        <div class="giornalino-container" style="width: 100%; background: #fff; border: 2px solid #004a99; border-radius: 15px; padding: 20px; box-sizing: border-box; text-align: center; box-shadow: 0 8px 20px rgba(0,0,0,0.1);">
            <h4 style="margin: 0 0 15px 0; color: #004a99; text-transform: uppercase; font-weight: 800; font-size: 1.1rem; letter-spacing: 1px;">
                {{ giornalino.titolo }}
            </h4>
            {% if giornalino.testo %}
            <p style="font-size: 0.9rem; color: #555; margin-bottom: 20px;">{{ giornalino.testo | safe }}</p>
            {% endif %}
             <a href="{{ giornalino.pdf }}"
                target="_blank"
                onmouseover="this.style.backgroundColor='#3a6ad4'; this.style.transform='scale(1.05)';"
                onmouseout="this.style.backgroundColor='#416fc8'; this.style.transform='scale(1)';"
                style="display: inline-flex;
                       align-items: center;
                       justify-content: center;
                       padding: 14px 28px;
                       margin-top: 15px;
                       background-color: #416fc8;
                       color: white;
                       text-decoration: none;
                       border-radius: 8px;
                       font-weight: bold;
                       font-size: 1.1rem;
                       gap: 12px;
                       line-height: 1;
                       transition: all 0.2s ease;
                       box-shadow: 0 4px 10px rgba(0,0,0,0.15);
                       cursor: pointer;">
               <i class="fa-solid fa-file-pdf" style="font-size: 1.3rem;"></i> Visualizza
             </a>
        </div>

    </div>

    <div class="primo-piano-container" style="flex: 2; min-width: 350px; max-width: 650px; background: #fff; border: 3px solid #004a99; border-radius: 20px; overflow: hidden; box-shadow: 0 12px 25px rgba(0,0,0,0.15);">
        <div style="background: #004a99; color: white; padding: 20px 10px; text-align: center;">
            <h3 style="margin: 0; text-transform: uppercase; letter-spacing: 0.07em; font-size: clamp(1rem, 5vw, 1.8rem); font-weight: 900; display: flex; align-items: center; justify-content: center; gap: 0.5em; white-space: nowrap;">
                <svg viewBox="0 0 24 24" fill="#f7c948" aria-hidden="true" style="width: 0.8em; height: 0.8em; flex-shrink: 0;"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                In primo piano
                <svg viewBox="0 0 24 24" fill="#f7c948" aria-hidden="true" style="width: 0.8em; height: 0.8em; flex-shrink: 0;"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
            </h3>
        </div>

        {% if datiPrimoPiano.titolo %}
        <div style="padding: 20px 20px 10px 20px; text-align: center; background-color: #fff;">
            <h4 style="margin: 0; color: #004a99; font-size: 1.6rem; font-weight: 800; text-transform: uppercase;">
                {{ datiPrimoPiano.titolo }}
            </h4>
        </div>
        {% endif %}

        {% if datiPrimoPiano.foto %}
        <div style="padding: 0 15px; background-color: #fff;">
            <img src="{{ datiPrimoPiano.foto | fotoRidotta(1300) }}" alt="In primo piano"
                 style="width: 100%; border-radius: 12px; display: block; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
        </div>
        {% endif %}

        {% if datiPrimoPiano.testo %}
        <div style="padding: 20px; text-align: center; background-color: #fff;">
            <p style="margin: 0; color: #444; font-size: 1.1rem; line-height: 1.5; white-space: pre-line;">
                {{ datiPrimoPiano.testo | safe }}
            </p>
        </div>
        {% endif %}
    </div>

</div>
</section>

<script>
// "Leggi tutto" compare solo sotto le notizie il cui testo supera le 4 righe
// (si ricontrolla quando cambia la larghezza, ad esempio ruotando il telefono)
const testiNotizie = document.querySelectorAll(".notizia-testo");
function mostraLeggiTutto() {
    testiNotizie.forEach(function(testo) {
        if (!testo.classList.contains("aperta")) {
            testo.nextElementSibling.hidden = testo.scrollHeight - testo.clientHeight < 2;
        }
    });
}
testiNotizie.forEach(function(testo) {
    const pulsante = testo.nextElementSibling;
    pulsante.addEventListener("click", function() {
        const aperta = testo.classList.toggle("aperta");
        pulsante.textContent = aperta ? "Mostra meno" : "Leggi tutto";
    });
});
mostraLeggiTutto();
window.addEventListener("resize", mostraLeggiTutto);
</script>